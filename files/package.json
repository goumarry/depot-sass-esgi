{
  "name": "mon-projet-tailwind",
  "version": "1.0.0",
  "description": "Projet Tailwind CSS configuré de zéro avec optimisation CSS",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./dist/output.css",
    "watch": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}
